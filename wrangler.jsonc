{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tibia-warden-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "warden.horothenic.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "CARDS",
      "id": "0b8181a9c27b403d93c22e3fc41f528a"
    }
  ],
  "assets": {
    "directory": "./data",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
